# Configuracoes do Banco de Dados MySQL
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=genesisteste
MYSQL_PORT=3306

# URL do backend Laravel (onde o worker envia alertas via POST)
LARAVEL_API_URL=http://localhost:8000/api

# Gemini — classificacao e traducao (Radar News V1.1)
# Chamada direta a API publica do Google (generativelanguage.googleapis.com).
# GENESIS_AI_URL e so o host (sem path) — o /v1beta/models/{model}:generateContent
# e montado pelo codigo. GENESIS_AI_TOKEN e a API key do Google (AIza...).
GENESIS_AI_URL=https://generativelanguage.googleapis.com
GENESIS_AI_TOKEN=
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash

# Configuracoes do Telegram
# 1. Abra o Telegram e busque por @BotFather
# 2. Envie o comando /newbot e siga as instrucoes para criar e dar um nome
# 3. Copie o token HTTP API gerado e cole abaixo em TELEGRAM_BOT_TOKEN
# 4. Busque por @userinfobot (ou similar) no Telegram para descobrir seu CHAT ID e cole em TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
